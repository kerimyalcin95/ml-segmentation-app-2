{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach Electron Main",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "restart": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Attach Electron Renderer",
            "type": "pwa-chrome",
            "request": "attach",
            "port": 9222,
            "webRoot": "${workspaceFolder}/svelte-frontend",
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/**",
                "!**/node_modules/**"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Attach Electron",
            "configurations": [
                "Attach Electron Main",
                "Attach Electron Renderer"
            ]
        }
    ]
}